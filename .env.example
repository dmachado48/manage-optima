# Optima Desk — copy to .env and fill in cPanel MySQL credentials.
# DB_HOST="localhost"
# DB_NAME="webitonc_manage-webiton"
# DB_USER="webitonc_manage-webiton"
# DB_PASSWORD="PASSWORD_DO_UTILIZADOR_MYSQL"
# Prisma reads DATABASE_URL; URL-encode special characters in the password.
DATABASE_URL="mysql://webitonc_manage-webiton:PASSWORD_DO_UTILIZADOR_MYSQL@localhost:3306/webitonc_manage-webiton?connection_limit=5&pool_timeout=20"
AUTH_SECRET="generate-a-long-random-string"
AUTH_URL="http://localhost:3000"
# Production: AUTH_URL="https://manage.webiton.pt"
ADMIN_EMAIL="admin@webiton.pt"
ADMIN_PASSWORD="change-me"
# Inbound email
# INBOUND_EMAIL_SECRET="long-random-for-webhook"
# CRON_SECRET="long-random-for-imap-cron"
# IMAP_HOST="mail.webiton.pt"
# IMAP_PORT="993"
# IMAP_SECURE="true"
# IMAP_USER="suporte@webiton.pt"
# IMAP_PASSWORD=
# IMAP_BATCH_SIZE="25"
# IMAP_MAX_MESSAGE_BYTES="20971520"
# SMTP_HOST="mail.webiton.pt"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="suporte@webiton.pt"
# SMTP_PASSWORD=
# SMTP_FROM_NAME="Webiton Suporte"
# Optional later
# OPENAI_API_KEY=