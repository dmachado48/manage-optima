generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  client
}

enum ContractType {
  retainer
  pack
  hourly
}

enum InterventionBillingStatus {
  included
  billable
  billed
  non_billable
}

enum RequestStatus {
  requested
  in_progress
  waiting_on_client
  done
}

enum RequestSource {
  email
  manual
  portal
  ad_hoc
}

enum ProjectStatus {
  intake
  scoping
  proposal_sent
  approved
  in_build
  delivered
  cancelled
}

enum ProposalStatus {
  draft
  sent
  approved
  rejected
  revised
}

enum BuildTaskStatus {
  todo
  in_progress
  waiting_on_client
  done
}

enum IntakeSource {
  email
  audio
  manual
}

enum InboundEmailStatus {
  pending
  matched
  assigned
  ignored
}

enum MessageAuthor {
  admin
  client
}

/// End client vs partner where we are subcontracted.
enum ClientRelation {
  end_client
  partner
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  role         UserRole @default(client)
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  interventions Intervention[] @relation("InterventionAuthor")
}

model Client {
  id               String         @id @default(cuid())
  name             String
  email            String?
  domain           String?
  contactName      String?
  phone            String?
  notes            String?        @db.Text
  /// Cliente final ou parceiro (somos subcontratados).
  relation         ClientRelation @default(end_client)
  active           Boolean        @default(true)
  kanbanShareToken String         @unique @default(cuid())
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  users         User[]
  contracts     Contract[]
  requests      Request[]
  interventions Intervention[]
  reports       Report[]
  projects      Project[]
  inboundEmails InboundEmail[]

  @@index([active, name])
  @@index([relation, name])
}

model Contract {
  id             String       @id @default(cuid())
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type           ContractType
  /// Included hours (pack total, or avença monthly plafond).
  hoursTotal     Decimal      @default(0) @db.Decimal(10, 2)
  hoursUsed      Decimal      @default(0) @db.Decimal(10, 2)
  /// For hourly / optional overage rate. Avença uses monthlyFeeEur as the agreed monthly amount.
  hourlyRate     Decimal?     @db.Decimal(10, 2)
  /// Fixed monthly fee for retainer (avença).
  monthlyFeeEur  Decimal?     @db.Decimal(12, 2)
  /// Markdown job description for retainer/avença — scope of included work.
  jobDescription String?      @db.LongText
  /// Calendar month key `YYYY-MM` for retainer hours (non-rollover). Reset when month changes.
  periodKey      String?
  startsAt       DateTime?
  endsAt         DateTime?
  active         Boolean      @default(true)
  billedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([clientId, active])
}

model Request {
  id             String        @id @default(cuid())
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title          String
  description    String?       @db.Text
  status         RequestStatus @default(requested)
  source         RequestSource @default(manual)
  emailMessageId String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  interventions Intervention[]
  inboundEmails InboundEmail[]
  messages      RequestMessage[]
  attachments   RequestAttachment[]

  @@index([clientId, status])
}

model RequestMessage {
  id          String              @id @default(cuid())
  requestId   String
  request     Request             @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author      MessageAuthor
  body        String              @db.Text
  createdAt   DateTime            @default(now())
  attachments RequestAttachment[]

  @@index([requestId, createdAt])
}

model RequestAttachment {
  id         String         @id @default(cuid())
  requestId  String
  request    Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  messageId  String?
  message    RequestMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  uploadedBy MessageAuthor
  createdAt  DateTime       @default(now())

  @@index([requestId])
  @@index([messageId])
}

model InboundEmail {
  id              String             @id @default(cuid())
  messageId       String             @unique
  fromAddress     String
  fromName        String?
  toAddress       String?
  subject         String
  bodyText        String             @db.LongText
  receivedAt      DateTime           @default(now())
  status          InboundEmailStatus @default(pending)
  matchedClientId String?
  matchedClient   Client?            @relation(fields: [matchedClientId], references: [id])
  requestId       String?            @unique
  request         Request?           @relation(fields: [requestId], references: [id])
  matchReason     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status, receivedAt])
  @@index([fromAddress])
}

model Intervention {
  id            String                     @id @default(cuid())
  clientId      String
  client        Client                     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requestId     String
  request       Request                    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  minutes       Int
  note          String?                    @db.Text
  billingStatus InterventionBillingStatus  @default(billable)
  billedAt      DateTime?
  reportId      String?
  report        Report?                    @relation(fields: [reportId], references: [id], onDelete: SetNull)
  performedAt   DateTime                   @default(now())
  createdById   String?
  createdBy     User?                      @relation("InterventionAuthor", fields: [createdById], references: [id])
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@index([clientId, performedAt])
  @@index([requestId])
  @@index([billingStatus, performedAt])
  @@index([reportId])
}

model Report {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  batchCode     String?  @unique
  periodStart   DateTime
  periodEnd     DateTime
  body          String   @db.Text
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  interventions Intervention[]

  @@index([clientId, periodStart])
}

model Project {
  id          String        @id @default(cuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  status      ProjectStatus @default(intake)
  deadline    DateTime?
  budgetEur   Decimal?      @db.Decimal(12, 2)
  costRateEur Decimal?      @db.Decimal(10, 2)
  billedAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  intakes   ProjectIntake[]
  scopes    ScopeDocument[]
  proposals Proposal[]
  tasks     BuildTask[]

  @@index([clientId, status])
  @@index([deadline])
}

model ProjectIntake {
  id         String       @id @default(cuid())
  projectId  String
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source     IntakeSource @default(manual)
  emailBody  String?      @db.Text
  transcript String?      @db.Text
  audioUrl   String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model ProposalTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  htmlLayout  String   @db.LongText
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  proposals Proposal[]
}

model ScopeDocument {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  body      String   @db.LongText
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Proposal {
  id           String         @id @default(cuid())
  projectId    String
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  templateId   String?
  template     ProposalTemplate? @relation(fields: [templateId], references: [id])
  title        String
  body         String         @db.LongText
  amountEur    Decimal        @db.Decimal(12, 2)
  status       ProposalStatus @default(draft)
  proposalDate DateTime       @default(now())
  sentAt       DateTime?
  decidedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([projectId, status])
  @@index([status, decidedAt])
  @@index([proposalDate])
}

model BuildTask {
  id                String          @id @default(cuid())
  projectId         String
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title             String
  notes             String?         @db.Text
  status            BuildTaskStatus @default(todo)
  sortOrder         Int             @default(0)
  estimatedMinutes  Int?
  spentMinutes      Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([projectId, status])
}

model FinanceYear {
  id          String           @id @default(cuid())
  year        Int              @unique
  annualGoal  Decimal          @db.Decimal(12, 2)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  quarters    FinanceQuarter[]
}

model FinanceQuarter {
  id        String      @id @default(cuid())
  yearId    String
  year      FinanceYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
  quarter   Int
  target    Decimal     @db.Decimal(12, 2)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([yearId, quarter])
}

model DailyPlanItem {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  title     String
  done      Boolean  @default(false)
  requestId String?
  taskId    String?
  proposalId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date, done])
}

model DailyResume {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  body      String   @db.Text
  totalMinutes Int   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Singleton row (`id = "default"`) for platform-wide business settings.
model PlatformConfig {
  id                   String   @id @default("default")
  /// Prices entered in proposals/budgets include VAT.
  pricesIncludeVat     Boolean  @default(false)
  /// Show quarter/finance figures with VAT applied/removed for display.
  showQuarterWithVat   Boolean  @default(false)
  /// VAT rate percentage (e.g. 23 for Portugal).
  vatRatePercent       Decimal  @default(23) @db.Decimal(5, 2)
  /// Default internal cost rate (€/h) suggested for new projects.
  defaultCostRateEur   Decimal? @db.Decimal(10, 2)
  /// Default billing / overage rate (€/h) for new contracts.
  defaultBillingRateEur Decimal? @db.Decimal(10, 2)

  companyName          String?
  companyNif           String?
  companyAddress       String?  @db.Text
  companyEmail         String?
  companyPhone         String?
  companyIban          String?
  companyWebsite       String?

  /// Markdown/plain text appended to proposal HTML footer.
  proposalFooter       String?  @db.Text

  /// Round logged minutes up to this block (0 = off). Typical: 15 or 30.
  timeRoundingMinutes  Int      @default(30)
  /// Minimum billable minutes when rounding is on.
  timeMinimumMinutes   Int      @default(30)

  currency             String   @default("EUR")
  locale               String   @default("pt-PT")
  /// Month (1–12) when the fiscal year starts. 1 = calendar year.
  fiscalYearStartMonth Int      @default(1)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}
